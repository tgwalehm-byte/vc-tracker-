{
  "name": "vc-join-leave",
  "description": "Telegram Voice Chat JOIN and LEAVE Tracker",
  "repository": "https://github.com/tgwalehm-byte/vc-tracker-",
  "keywords": [
    "telegram",
    "voice-chat",
    "tracker",
    "pyrogram",
    "mongodb"
  ],
  "env": {
    "API_ID": {
      "description": "Telegram API ID",
      "required": true
    },
    "API_HASH": {
      "description": "Telegram API HASH",
      "required": true
    },
    "BOT_TOKEN": {
      "description": "Telegram Bot Token",
      "required": true
    },
    "SESSION_STRING": {
      "description": "Pyrogram User Session String",
      "required": true
    },
    "MONGO_URL": {
      "description": "MongoDB connection URL",
      "required": true
    },
    "LOG_CHANNEL": {
      "description": "Telegram Log Channel ID",
      "required": true
    },
    "OWNER_ID": {
      "description": "Telegram numeric Owner User ID",
      "required": true
    },
    "POLL_SECONDS": {
      "description": "Reconciliation interval",
      "value": "3",
      "required": false
    }
  },
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "basic"
    }
  }
}